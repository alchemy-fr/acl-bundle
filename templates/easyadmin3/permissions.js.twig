$(function () {
    const objectType = '{{ object_type|e('js') }}';
    const objectId = {% if object_id is defined %}'{{ object_id|e('js') }}'{% else %}null{% endif %};
    const userWildcard = '{{ USER_WILDCARD|e('js') }}';

    $('body')
        .on('change', '.perm input[type=checkbox]', function () {
            const $tr = $(this).closest('tr');

            syncToggle($tr);
            updateAce($tr);
        })
        .on('click', 'input[name=all]', function () {
            var $tr = $(this).closest('tr');
            $tr.find('.perm input').prop('checked', $(this).is(':checked'));
            updateAce($tr);
        })
        .on('click', '.delete', function () {
            var $tr = $(this).closest('tr');
            $tr.remove();
            deleteAce($tr.attr('data-type'), $tr.attr('data-id'));
        });

    $('#aces tr').each(function () {
        syncToggle($(this));
    });

    function syncToggle($tr) {
        let checkedCount = $tr.find('.perm input[type=checkbox]:checked').length;
        if (checkedCount === {{ permissions|length }}) {
            $tr.find('.all-toggle input').prop('checked', true);
        } else if (checkedCount === 0) {
            $tr.find('.all-toggle input').prop('checked', false);
        }
    }

    function updateAce($tr) {
        let mask = 0;
        $tr.find('td.perm input').each(function () {
            mask += $(this).is(':checked') ? parseInt($(this).val()) : 0;
        });
        setPermissions($tr.attr('data-type'), $tr.attr('data-id'), mask);
    }

    function isInList(id, type) {
        return $('#aces tr').filter(function () {
            return $(this).attr('data-id') === id && $(this).attr('data-type') === type;
        }).length === 1;
    }

    function setPermissions(userType, userId, mask) {
        $.ajax({
            type: 'PUT',
            url: '{{ path('alchemy_acl_admin_ace')|e('js') }}',
            contentType: 'application/json',
            data: JSON.stringify({
                objectType: objectType,
                objectId: objectId,
                userId: userId,
                userType: userType,
                mask: mask
            })
        });
    }

    function deleteAce(userType, userId) {
        $.ajax({
            type: 'DELETE',
            url: '{{ path('alchemy_acl_admin_ace_delete')|e('js') }}',
            contentType: 'application/json',
            data: JSON.stringify({
                objectType: objectType,
                objectId: objectId,
                userId: userId,
                userType: userType
            })
        });
    }

    function initSelect($select, userType) {
        $select
            .select2({
                width: '400px',
                placeholder: "Select " + userType + " to grant...",
                templateResult: function (state) {
                    if (!state.id) {
                        return state.text;
                    }

                    return $('<span>')
                        .addClass(state.element.className)
                        .toggleClass('disabled', isInList(state.id, userType))
                        .text(state.text);
                }
            })
            .on('select2:select', function () {
                const data = $(this).select2('data');
                const userId = data[0].id;

                $(this).val(null).trigger('change');
                if (isInList(userId, userType)) {
                    return false;
                }

                setPermissions(userType, userId, 0);

                // User and group names are untrusted: they are only ever set as text or attribute values
                const $newAce = $($.parseHTML($('#row-template').html().trim()))
                    .attr('data-id', userId)
                    .attr('data-type', userType)
                    .addClass('type-' + userType);
                $newAce.find('.entity-name').text(data[0].text);
                if (userId === userWildcard) {
                    $newAce.addClass('type-wildcard');
                }
                $('#aces tbody').prepend($newAce);
            });
    }

    initSelect($('#group-select'), 'group');
    initSelect($('#user-select'), 'user');
});
